  "type": "module",
  "bugs": {
    "url": "https://github.com/nelsonlondonodev/landing_Narbos_peluqueria/issues"
  },
  "homepage": "https://github.com/nelsonlondonodev/landing_Narbos_peluqueria#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "csso-cli": "^4.0.2",
    "esbuild": "^0.28.1",
    "gh-pages": "^6.3.0",
    "html-minifier": "^4.0.0",
    "imagemin": "^9.0.1",
    "imagemin-cli": "^8.0.0",
    "imagemin-webp": "^8.0.0",
    "jsdom": "29.1.1",
    "passkit-generator": "^3.5.7",
    "purgecss": "^8.0.0",
    "qrcode": "^1.5.4",
    "svgo": "^4.0.0",
    "tailwindcss": "^4.3.2",
    "terser": "^5.49.0",
    "uuid": "^14.0.1"
  }
}
