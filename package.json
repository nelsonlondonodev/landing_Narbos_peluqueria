{
  "name": "narbos_salon_web",
  "version": "2.8.33",
  "description": "Sitio web oficial y plataforma de servicios para Narbo's Salón Spa. Plataforma moderna optimizada con HTML5, Tailwind CSS y Vanilla JS.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rm -rf dist",
    "dev": "npx @tailwindcss/cli -i ./css/input.css -o ./css/styles.css --watch",
    "new-post": "node scripts/create-article.js",
    "generate:blog": "node scripts/generate-blog.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:video-dates": "node scripts/sync-video-dates.js",
    "generate:video-schema": "node scripts/generate-video-schema.js",
    "preview": "node scripts/preview.js",
    "index-now": "node scripts/index-now.js",
    "generate:hours": "node scripts/sync-google-hours.js",
    "generate:reviews": "node scripts/sync-google-reviews.js",
    "build": "node scripts/apply-version.js && pnpm generate:hours && pnpm generate:reviews && pnpm generate:video-dates && pnpm generate:video-schema && pnpm generate:blog && pnpm generate:sitemap && node scripts/build.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nelsonlondonodev/landing_Narbos_peluqueria.git"
  },
  "keywords": [],
